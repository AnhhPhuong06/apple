# Admin login is required in all environments. Copy to .env to configure hosting.
HOST=127.0.0.1
PORT=4173
# Public HTTPS origin, without a path. Needed for OTA installation on iPhone.
# PUBLIC_BASE_URL=https://apps.example.com
# Optional HTTPS upload host, with DNS-only A record pointing to the same VPS.
# Only IPA chunks use this host; admin cookies, passwords and certificate files stay on PUBLIC_BASE_URL.
# UPLOAD_BASE_URL=https://upload.apps.example.com
# On Render, the app automatically uses RENDER_EXTERNAL_URL if PUBLIC_BASE_URL is unset.
# Admin login password (at least 24 characters). Keep it private.
# If omitted, a random password is generated once in DATA_DIR/admin-key.txt.
# ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional absolute paths:
# DATA_DIR=D:/WebApple/data
# ZSIGN_BIN=D:/WebApple/tools/zsign/zsign.exe
# OpenSSL 3 is used for saved-certificate checks. Ubuntu: /usr/bin/openssl.
# OPENSSL_BIN=C:/Program Files/Git/usr/bin/openssl.exe
